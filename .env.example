# Copy this file to .env and fill values for your local setup.

APP_ENV=development
APP_HOST=localhost
APP_PORT=3000

# Postgres container (docker-compose.yml reads these directly)
POSTGRES_USER=myplaylist
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=myplaylist
POSTGRES_PORT=5432

# Consumed by the backend; host is the compose service name, not localhost
DATABASE_URL=postgresql+psycopg2://myplaylist:change-me-locally@postgres:5432/myplaylist

# Confirmation email. Use STARTTLS or SSL for a real SMTP provider.
# For local Mailpit, add docker-compose.mailpit.yml and set SMTP_SECURITY=none.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me

# Required for signed account-deletion email tokens. Use at least 32 random bytes.
PRIVACY_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Comma-separated exact browser origins (no paths or wildcards).
# Local HTTPS through Caddy; use the same hostname for login and WebSockets.
WEBSOCKET_ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# EXTERNAL APIs
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Grafana monitoring dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally

# 42 OAuth login (the redirect URI must match the one registered in the 42 app; Caddy serves https://localhost)
FT42_CLIENT_ID=your-42-client-id
FT42_CLIENT_SECRET=your-42-client-secret
FT42_REDIRECT_URI=https://localhost/api/v1/auth/42/callback

# Where the backend sends the browser after OAuth login (success or ?error=)
FRONTEND_URL=https://localhost
