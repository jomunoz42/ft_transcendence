# Copy this file to .env and fill values for your local setup.

APP_ENV=development
APP_HOST=localhost
APP_PORT=3000

# Postgres container (docker-compose.yml reads these directly)
POSTGRES_USER=myplaylist
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=myplaylist
POSTGRES_PORT=5432
BACKEND_PORT=8000

# Consumed by the backend; host is the compose service name, not localhost
DATABASE_URL=postgresql+psycopg2://myplaylist:change-me-locally@postgres:5432/myplaylist

# Comma-separated exact browser origins (no paths or wildcards).
# For HTTPS deployment replace these with https://your-frontend.example.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
